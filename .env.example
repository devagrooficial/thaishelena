# Login do sistema (configure também no Vercel → Settings → Environment Variables)
ADMIN_USER=thais
ADMIN_PASSWORD=troque-esta-senha
# Texto aleatório longo para assinar a sessão (ex.: openssl rand -hex 32)
AUTH_SECRET=

# Banco de dados
# Local: deixe em branco → usa o arquivo ./data/local.db
# Vercel: banco Turso FIXO (veja o README). Têm prioridade sobre TURSO_DATABASE_URL/TURSO_AUTH_TOKEN.
BANCO_URL=
BANCO_TOKEN=
